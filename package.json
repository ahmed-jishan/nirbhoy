{
  "name": "nirbhoy",
  "version": "1.0.0",
  "private": true,
  "description": "Nirbhoy — anonymous civic complaint & whistleblower platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "create-admin": "node scripts/create-admin.js",
    "sync-admins": "node scripts/sync-admins.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --no-eslintrc --config .eslintrc.json --ignore-pattern node_modules --ignore-pattern .next",
    "ci": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@next/font": "^14.2.15",
    "@sentry/nextjs": "^8.55.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "cloudinary": "2.3.0",
    "firebase": "10.12.4",
    "firebase-admin": "12.3.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1",
    "next": "14.2.35",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "pino-pretty": "^13.1.3",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
